# 이 파일을 .env로 복사한 뒤 값을 채우세요.  (cp .env.example .env)
# .env는 git에 올라가지 않습니다. 비밀번호는 .env에만 적으세요.

# 앱이 열릴 주소와 포트 (Apache가 같은 서버에서 프록시하므로 127.0.0.1 권장)
HOST=127.0.0.1
PORT=3001

# "게임 시작" 버튼이 연결될 게임 서비스 주소
GAME_URL=http://game.aquabit.lab

# 사내 메일 서버(hMailServer) SMTP 설정
# 실습용 서버라 25번 포트, 암호화 없이 AUTH LOGIN으로 로그인합니다.
SMTP_HOST=mail.aquabit.lab
SMTP_PORT=25
SMTP_USER=noreply@aquabit.lab
SMTP_PASS=
# 보내는 사람 주소 (비우면 SMTP_USER 사용)
MAIL_FROM=noreply@aquabit.lab
# 문의 메일을 받을 주소
MAIL_TO=support@aquabit.lab
